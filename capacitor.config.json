{
  "appId": "com.qinggan.travel",
  "appName": "随时Go",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F5F5F7"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#F5F5F7",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT",
      "backgroundColor": "#00000000"
    }
  }
}